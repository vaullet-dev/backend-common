<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The bill of materials consumers import.

    Deliberately standalone — no <parent>. A BOM that inherits from something drags that
    something's dependencyManagement into every consumer, which is how importing one small BOM
    silently pins a service's entire Spring version. This file manages exactly four artifacts
    and nothing else.

    Usage in a service POM:

      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>io.vaullet</groupId>
            <artifactId>backend-common-bom</artifactId>
            <version>0.1.0</version>
            <type>pom</type>
            <scope>import</scope>
          </dependency>
        </dependencies>
      </dependencyManagement>

    after which the modules are declared without a version, and one line upgrades all of them
    together. Mixed versions of these four modules are not a supported combination: they share
    the ErrorType interface and the property prefix, so they move as a set.
  -->
  <groupId>io.vaullet</groupId>
  <artifactId>backend-common-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Vaullet Backend Common BOM</name>
  <description>Dependency management for the backend-common modules</description>

  <!--
    GHCR Maven, matching ADR-002's contract pipeline. Credentials come from the
    `github` server in the CI-generated settings.xml, never from this file.
  -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/vaullet-io/backend-common</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/vaullet-io/backend-common</url>
    </snapshotRepository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vaullet</groupId>
        <artifactId>backend-common-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vaullet</groupId>
        <artifactId>backend-common-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vaullet</groupId>
        <artifactId>backend-common-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vaullet</groupId>
        <artifactId>backend-common-test</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
