<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.vaullet</groupId>
    <artifactId>common-parent</artifactId>
    <version>0.0.0-DEV</version>
  </parent>

  <artifactId>common-test</artifactId>
  <name>Vaullet Backend Common :: Test</name>
  <description>Composed @IntegrationTest, a shared Postgres container, and the ArchUnit rule set</description>

  <!--
    A separate artifact because its dependencies are the point: Testcontainers, the Boot test
    starters and ArchUnit are all things a service must NOT ship. Consumers declare this with
    <scope>test</scope>, which is where every one of these transitively lands.

    The dependencies below are compile-scoped WITHIN this module — a test-scoped dependency is
    not transitive, so declaring them test here would compile this module and then hand
    consumers a jar whose types cannot be resolved.
  -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
    </dependency>
    <!--
      TestSecurityConfiguration needs JwtDecoder to exist; the postprocessors that let a test
      authenticate against the real chain (SecurityMockMvcRequestPostProcessors.jwt()) come with
      the two -test starters. Assembling the production filter chain and then bypassing it with
      addFilters = false would make every security assertion in the fleet meaningless, so the
      tools to do it properly ship with the annotation that requires them.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>
</project>
