<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Aggregator and build parent for the @vaullet-dev backend libraries.

    This inherits from spring-boot-starter-parent for its dependency management and plugin
    configuration ONLY. Nothing here is a Spring Boot application: no module is repackaged into
    a fat jar, and spring-boot-maven-plugin is deliberately never declared. A library that ships
    as a Boot uber-jar cannot be depended on, which is the single most common way a "common"
    module becomes unusable.

    Consumers do NOT inherit from this POM. They inherit from spring-boot-starter-parent as
    usual and import common-bom, so a service can be on a different Boot patch version
    than the one this library was built against.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.vaullet</groupId>
  <artifactId>common-parent</artifactId>
  <!--
    CI-friendly version. ${revision} is one of the three properties Maven resolves inside a
    <version> element, so the number lives in exactly one place and a release is
    `-Drevision=1.2.3` rather than a commit that rewrites six POMs. flatten-maven-plugin below
    substitutes the literal into the POM that gets installed and deployed, so a consumer never
    sees an unresolved property.

    Nothing computes that number by hand. scripts/version.sh reads it off the commit log:

        ./mvnw -Drevision="$(scripts/version.sh)" verify

    See the header of that script for the three commit types and what each one moves.
  -->
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Vaullet Backend Common</name>
  <description>Cross-cutting plumbing shared by @vaullet-dev backend services</description>
  <url>https://github.com/vaullet-dev/backend-common</url>

  <modules>
    <module>common-bom</module>
    <module>common-core</module>
    <module>common-web</module>
    <module>common-security</module>
    <module>common-test</module>
  </modules>

  <properties>
    <!--
      Fallback only, and deliberately not a version anybody could mistake for a release.
      Every real build passes -Drevision from scripts/version.sh; this value exists so that
      `mvn` and an IDE import still resolve when nobody did.

      It is NOT -SNAPSHOT. A snapshot is a mutable coordinate — two builds of "0.1.0-SNAPSHOT"
      can contain different code — and this project has none of them: main publishes releases,
      a branch publishes an immutable pre-release like 0.2.0-holds-7. Nothing here is ever
      overwritten, so "which build is that" always has an answer. See CHANGELOG.md for what
      changed at each version and the README's "Versioning" section for what MAJOR, MINOR and
      PATCH mean for *this* library, which is not quite what they mean for a wire contract.

      common-bom repeats this default because it has no parent to inherit it from (deliberately:
      see its own comment). CI asserts the two agree.
    -->
    <revision>0.0.0-DEV</revision>

    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Versions not managed by the Spring Boot BOM -->
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <japicmp-maven-plugin.version>0.26.2</japicmp-maven-plugin.version>
    <springdoc.version>3.1.0</springdoc.version>
    <archunit.version>1.4.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Sibling modules, so a module POM never repeats ${project.version} -->
      <dependency>
        <groupId>dev.vaullet</groupId>
        <artifactId>common-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.vaullet</groupId>
        <artifactId>common-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.vaullet</groupId>
        <artifactId>common-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.vaullet</groupId>
        <artifactId>common-test</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    GHCR Maven, matching ADR-002's contract pipeline. Credentials come from the
    `github` server in the CI-generated settings.xml, never from this file.
  -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <!--
        The owner here must be the GitHub organisation that OWNS the repository, exactly as it
        is spelled today. GitHub redirects a renamed org for git and for the web, but NOT for
        Packages: a workflow's GITHUB_TOKEN is scoped to the repository it runs in, so a deploy
        addressed to the old name is a 403 with nothing wrong upstream of it.
      -->
      <url>https://maven.pkg.github.com/vaullet-dev/backend-common</url>
    </repository>
    <!--
      No <snapshotRepository>, on purpose. Without one, a `deploy` of anything ending in
      -SNAPSHOT fails with "repository element was not specified" rather than quietly
      publishing a mutable coordinate that a consumer can never pin. The absence is the
      enforcement.
    -->
  </distributionManagement>

  <build>
    <plugins>
      <!--
        Resolves ${revision} in the POM that is installed and deployed. Without it a consumer
        resolving common-core would get a POM whose <version> is the literal string
        "${revision}", which Maven cannot use.

        Mode `resolveCiFriendliesOnly` is the conservative one: it substitutes revision/sha1/
        changelist and changes nothing else. The other modes rewrite the POM into an "effective"
        form — which for common-bom would inline the whole Spring Boot dependencyManagement it
        inherits, turning a five-entry BOM into a several-hundred-entry one that pins a
        consumer's entire Spring version. That is precisely what this library must not do.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Keeps parameter names for Spring binding and @ConfigurationProperties -->
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>


      <!--
        Semantic versioning, enforced rather than asserted.
        =================================================

        A README that says "we use semver" is a promise; this plugin is the part that keeps it.
        japicmp compares the API of each module against its last release and fails the build when
        the version number does not match the size of the change: remove a public method without
        bumping MAJOR, or add one without bumping MINOR, and the release stops here.

        This is the same shape the rest of the platform already uses for its other contracts —
        `oasdiff` gating the OpenAPI document (ADR-011 §5) and FULL_TRANSITIVE gating event schemas
        (ADR-007). A library's Java API is a contract with the same property: the people it breaks
        are not in the room when it is broken.

        `...ForMajorVersionZero` is on deliberately. Semver says 0.x may break anything, and that is
        exactly how a 0.x library trains its consumers to expect churn. The discipline is cheaper to
        start now, while there is one consumer, than to retrofit at 1.0 with fourteen.

        `ignoreMissingOldVersion` covers the two honest cases: the very first release, and a module
        added later. It does NOT cover a typo'd artifactId, so a rename is worth eyeballing the
        japicmp output for a suspiciously empty report.
      -->
      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <version>${japicmp-maven-plugin.version}</version>
        <configuration>
          <parameter>
            <skipPomModules>true</skipPomModules>
            <!-- Never take a SNAPSHOT as the baseline; a release is only ever compared to a release. -->
            <oldVersionPattern>\d+\.\d+\.\d+</oldVersionPattern>
            <onlyModified>true</onlyModified>
            <breakBuildBasedOnSemanticVersioning>true</breakBuildBasedOnSemanticVersioning>
            <breakBuildBasedOnSemanticVersioningForMajorVersionZero>true</breakBuildBasedOnSemanticVersioningForMajorVersionZero>
            <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
            <!-- Only our own API. A transitive Spring type changing is Spring's version to bump. -->
            <includes>
              <include>dev.vaullet.common</include>
            </includes>
          </parameter>
        </configuration>
        <executions>
          <execution>
            <id>api-compatibility</id>
            <phase>verify</phase>
            <goals>
              <goal>cmp</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        A library is consumed by reading it. The rationale comments in these classes are the
        documentation (see the README), so the sources jar is not a nicety here: it is what makes
        "why does this exist" answerable from the IDE of a service that only has the binary.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
